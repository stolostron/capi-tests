{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "github-actions",
    "dockerfile"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "timezone": "UTC",
  "schedule": [
    "on monday"
  ],
  "gomod": {
    "packageRules": [
      {
        "description": "Keep indirect Go modules on security-only updates. MintMaker's global config re-enables them from inside its own gomod.packageRules, which Renovate merges after top-level rules. Vulnerability alerts force-override this rule, so security fixes remain enabled.",
        "matchManagers": [
          "gomod"
        ],
        "matchDepTypes": [
          "indirect"
        ],
        "matchUpdateTypes": [
          "major",
          "minor",
          "patch",
          "pin",
          "digest",
          "pinDigest",
          "lockFileMaintenance",
          "rollback",
          "replacement"
        ],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "description": "Collect routine updates from every enabled manager into one weekly PR per base branch.",
      "matchManagers": [
        "gomod",
        "github-actions",
        "dockerfile"
      ],
      "groupName": "Weekly dependency updates"
    },
    {
      "description": "Keep dependency-update PRs easy to find.",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "description": "Keep the OpenShift CI builder image pinned; Renovate cannot authenticate to its registry.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile.prow"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "Security fixes",
    "labels": [
      "dependencies",
      "security"
    ],
    "prConcurrentLimit": 1
  }
}
